# Oracle's Choice frontend environment template.
# Copy this file to `.env` and adjust if your backend runs elsewhere.

# Base URL of the backend API (used by frontend/src/App.jsx).
# In dev this defaults to http://127.0.0.1:8001; in production builds it
# defaults to https://oracle-s-choice.onrender.com. Override here if needed.
VITE_API_BASE_URL=http://127.0.0.1:8001

# Oracle's Choice backend environment template.
# Copy this file to `.env` and fill in your own values.
# Never commit a real `.env`; only this template is tracked.

# ---- LLM provider keys ---------------------------------------------------
# Primary provider: Xiaomi MiMo (OpenAI-compatible Chat Completions API).
# When MIMO_API_KEY is set, the agent prefers MiMo over DeepSeek.
MIMO_API_KEY=
# OpenAI-compatible base URL. Endpoint = MIMO_BASE_URL + /chat/completions.
# Default matches the public spec; override only if you have a custom host.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Model name as advertised by your MiMo account/console.
# Example IDs returned by GET https://api.xiaomimimo.com/v1/models include
# mimo-v2-flash, mimo-v2-pro, mimo-v2.5, mimo-v2.5-pro, mimo-v2-omni, etc.
# Use a general chat model (not -tts) for this app.
MIMO_MODEL=mimo-v2.5

# Alternate provider: DeepSeek. Used only if MIMO_API_KEY is empty.
# Do NOT put a Xiaomi MiMo key here — this slot expects a real DeepSeek key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Other providers are recognized by PROVIDER_KEYS but not yet wired into
# main.py's startup filter. Leave blank unless you also extend that list.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- LLM tuning (all optional) ------------------------------------------
# Max tokens per LLM response (clamped to 1..8192). Defaults to 512.
# Used by parse / route classifier calls.
LLM_MAX_TOKENS=512
# Higher per-call cap used only by the narration node. MiMo reasoning
# models burn hundreds of tokens on internal reasoning_content before
# emitting visible content; 512 typically gets cut off with
# finish_reason=length and empty content. Defaults to 2048.
LLM_NARRATION_MAX_TOKENS=2048
# Retries per provider on failure. Minimum 1.
LLM_RETRIES=1
# When set to 1/true/yes/on, exposes the upstream provider's full
# raw_response_text and the model's reasoning_content in the per-attempt
# _debug trace. Off by default so the raw API body and the model's
# private chain-of-thought never leak into the frontend trace UI.
LLM_TRACE_DEBUG=
# Sampling temperature (per-provider override).
# MIMO_TEMPERATURE=0.7
# DEEPSEEK_TEMPERATURE=0.7

# ---- Storage -------------------------------------------------------------
# SQLite database file path. Defaults to backend/oracle_choice.db.
ORACLE_CHOICE_DB_PATH=oracle_choice.db

# Oracle's Choice backend environment template.
# Copy this file to `.env` and fill in your own values.
# Never commit a real `.env`; only this template is tracked.

# ---- LLM provider keys ---------------------------------------------------
# Primary provider (required for live LLM responses).
DEEPSEEK_API_KEY=

# Optional alternate providers. Leave blank if unused.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- LLM tuning (all optional) ------------------------------------------
# DeepSeek model name. Defaults to "deepseek-chat" when unset.
DEEPSEEK_MODEL=deepseek-chat
# Max tokens per LLM response (clamped to 1..8192). Defaults to 512.
LLM_MAX_TOKENS=512
# Retries per provider on failure. Defaults to 1.
LLM_RETRIES=1

# ---- Storage -------------------------------------------------------------
# SQLite database file path. Defaults to backend/oracle_choice.db.
ORACLE_CHOICE_DB_PATH=oracle_choice.db
